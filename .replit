modules = ["web", "bash", "python-3.12", "nodejs-22", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-drift"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-rebuild"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "book-visual"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-baseline"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-targeted-typecheck"

[[workflows.workflow]]
name = "migration-drift"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run migration:check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migration-rebuild"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/db run migration:rebuild-check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "book-visual"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/rgg-website run test:book-visual"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migration-baseline"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run test:migration-baseline"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-targeted-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run test:api-targeted-typecheck"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "cups", "dbus", "expat", "freetype", "glib", "gumbo", "harfbuzz", "jbig2dec", "libdrm", "libgbm", "libjpeg_turbo", "libxkbcommon", "mesa", "mupdf", "nspr", "nss", "openjpeg", "pango", "swig", "xcbuild", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[[ports]]
localPort = 4173
externalPort = 3001

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 23016
externalPort = 3000
