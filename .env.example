# RGG deployment environment — names and descriptions only; never add credentials.

# REQUIRED — all environments
DATABASE_URL=PostgreSQL connection string
DATABASE_SSL=true when the provider requires TLS certificate verification
DATABASE_SSL_CA=optional trusted CA certificate text when required by the provider
PGSSLMODE=optional PostgreSQL TLS mode such as verify-full
PORT=HTTP port supplied by the process manager
NODE_ENV=production|development|test
CSRF_SECRET=long random server-only secret
CLERK_PUBLISHABLE_KEY=matching Clerk environment publishable key
CLERK_SECRET_KEY=matching Clerk environment server secret
VITE_CLERK_PUBLISHABLE_KEY=matching public Clerk browser key

# REQUIRED — production origin and trusted requests
APP_ORIGIN=https://your-final-domain.example
APP_ORIGINS=comma-separated Replit rollback, temporary Hostinger, and final origins
PUBLIC_SITE_URL=https://your-final-domain.example
PUBLICATIONS_API_URL=https://your-api-origin.example/api/publications
TRUST_PROXY_HOPS=number of reviewed reverse-proxy hops, usually 1
STATIC_DIR=../rgg-website/dist/public when starting from the API package

# REQUIRED — persistent private object storage
PRIVATE_OBJECT_DIR=provider bucket/path for private uploaded objects
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=https://your-object-storage-endpoint.example
S3_REGION=provider region
S3_BUCKET=private media bucket
S3_ACCESS_KEY_ID=server-only access key identifier
S3_SECRET_ACCESS_KEY=server-only secret access key
S3_FORCE_PATH_STYLE=false

# REQUIRED when enquiry email is moved off the Replit connector
RESEND_API_KEY=server-only Resend API key
RESEND_API_URL=https://api.resend.com/emails
EMAIL_FROM=verified sender address on the production domain
EMAIL_TO=comma-separated enquiry recipients
EMAIL_CC=comma-separated enquiry copy recipients

# OPTIONAL — uploads, logging, monitoring
MAX_PDF_UPLOAD_MB=25
MAX_IMAGE_UPLOAD_MB=15
LOG_LEVEL=info
BETTER_STACK_INGESTING_URL=HTTPS Better Stack ingest endpoint
BETTER_STACK_SOURCE_TOKEN=server-only Better Stack source token
BETTER_STACK_ALERT_TIMEOUT_MS=3000

# DEVELOPMENT / TEST ONLY
BASE_PATH=/
SITE_URL=legacy build-origin alias; prefer PUBLIC_SITE_URL
VITE_CLERK_PROXY_URL=optional development Clerk proxy URL
BETTER_STACK_TEST_ALERT_ENABLED=false
CI=true

# LEGACY / REPLIT-COMPATIBILITY ONLY — do not add to Hostinger
REPL_ID=Replit development marker
REPLIT_DEV_DOMAIN=temporary Replit development domain
REPLIT_DOMAINS=comma-separated Replit deployment domains
ADMIN_API_ENABLED=legacy test flag; never grants authorization
SESSION_SECRET=legacy CSRF fallback; prefer CSRF_SECRET