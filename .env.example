# RGG deployment environment — variable names only; never add credentials.

# REQUIRED — all environments
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_CA=
PGSSLMODE=
PORT=
NODE_ENV=
CSRF_SECRET=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# REQUIRED — production origin and trusted requests
APP_ORIGIN=
APP_ORIGINS=
PUBLIC_SITE_URL=
# OPTIONAL — legacy external build metadata source; normal builds use DATABASE_URL
PUBLICATIONS_API_URL=
# EMERGENCY FIRST-DEPLOYMENT ONLY — exact value true permits empty metadata
ALLOW_EMPTY_PUBLICATIONS_BOOTSTRAP=
TRUST_PROXY_HOPS=
STATIC_DIR=

# REQUIRED — persistent private object storage
PRIVATE_OBJECT_DIR=
OBJECT_STORAGE_PROVIDER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# REQUIRED when enquiry email is moved off the Replit connector
RESEND_API_KEY=
RESEND_API_URL=
EMAIL_FROM=
EMAIL_TO=
EMAIL_CC=

# OPTIONAL — uploads, logging, monitoring
MAX_PDF_UPLOAD_MB=
MAX_IMAGE_UPLOAD_MB=
LOG_LEVEL=
BETTER_STACK_INGESTING_URL=
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_ALERT_TIMEOUT_MS=

# DEVELOPMENT / TEST ONLY
BASE_PATH=
SITE_URL=
VITE_CLERK_PROXY_URL=
BETTER_STACK_TEST_ALERT_ENABLED=
CI=

# LEGACY / REPLIT-COMPATIBILITY ONLY — do not add to Hostinger
REPL_ID=
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
ADMIN_API_ENABLED=
SESSION_SECRET=